# Copy file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# Môi trường (xem config/environments.js). Hiện có: stag
FTMS_ENV=stag

# OTP mặc định dùng chung cho tài khoản test trên stag
FTMS_OTP=

# Domain email ghép vào khi chỉ nhập tên tài khoản (vd: giangdc2 -> giangdc2@fpt.com)
FTMS_EMAIL_DOMAIN=fpt.com

# Tài khoản đăng nhập mặc định (để trống thì tool sẽ hỏi)
FTMS_USER=

# AM mặc định khi tạo cơ hội (userName trong BMS)
BMS_AM=giangdc2

# Tiền tố gắn vào tên cơ hội / khách hàng để dễ nhận biết & dọn dữ liệu
DATA_PREFIX=AUTO-QC

# true = chạy trình duyệt ẩn khi đăng nhập; false = hiện trình duyệt (dùng để debug)
HEADLESS=true

# Cổng giao diện web (npm run ui)
UI_PORT=3000

# Trình duyệt dùng để đăng nhập: auto (Chrome -> Edge -> Chromium) | chrome | msedge | chromium
BROWSER=auto

# --- Chạy trên server dùng chung (xem DEPLOY-SERVER.md) ---
# Địa chỉ lắng nghe. 127.0.0.1 = chỉ máy này (mặc định). 0.0.0.0 = mở cho máy khác trong mạng
UI_HOST=127.0.0.1
# Bắt buộc khi UI_HOST khác 127.0.0.1: tài khoản vào trang, dạng <tên>:<mật khẩu ≥ 8 ký tự>
UI_AUTH=
